{
  "_comment": "Emulators Borne installs, configures and starts. 'programs' says where each program comes from on each system and how it is started ({rom}, {core}, {config}, {lang_dolphin}); 'consoles' lists, per console, the choices offered in Settings -> Emulators (the first one is the default). Read by core/src/emulators.rs and core/src/emuinstall.rs. A console with an empty list has no usable emulator yet (Xbox One).",
  "programs": [
    {
      "id": "retroarch",
      "name": "RetroArch",
      "args": [
        "--config",
        "{config}",
        "-L",
        "{core}",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "buildbot",
          "file": "linux/x86_64/RetroArch.7z"
        },
        "macos": {
          "type": "buildbot",
          "file": "apple/osx/universal/RetroArch_Metal.dmg"
        }
      },
      "cores": {
        "linux": "https://buildbot.libretro.com/nightly/linux/x86_64/latest/{core}_libretro.so.zip",
        "macos": "https://buildbot.libretro.com/nightly/apple/osx/arm64/latest/{core}_libretro.dylib.zip"
      }
    },
    {
      "id": "dolphin",
      "name": "Dolphin",
      "args": [
        "-b",
        "-u",
        "{userdir}",
        "-C",
        "Dolphin.Core.SelectedLanguage={lang_dolphin}",
        "-e",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "flatpak",
          "id": "org.DolphinEmu.dolphin-emu"
        },
        "macos": {
          "type": "page",
          "url": "https://dolphin-emu.org/download/",
          "link": "https://dl.dolphin-emu.org/releases/",
          "ends": "-universal.dmg"
        }
      }
    },
    {
      "id": "pcsx2",
      "name": "PCSX2",
      "args": [
        "-batch",
        "-fullscreen",
        "-nogui",
        "--",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "PCSX2/pcsx2",
          "has": [
            "linux",
            "appimage",
            "x64"
          ],
          "ends": ".appimage"
        },
        "macos": {
          "type": "github",
          "repo": "PCSX2/pcsx2",
          "has": [
            "macos"
          ],
          "ends": ".tar.xz"
        }
      }
    },
    {
      "id": "duckstation",
      "name": "DuckStation",
      "args": [
        "-batch",
        "-fullscreen",
        "-nogui",
        "--",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "stenzek/duckstation",
          "has": [
            "x64"
          ],
          "ends": ".appimage",
          "prerelease": true
        },
        "macos": {
          "type": "github",
          "repo": "stenzek/duckstation",
          "has": [
            "mac"
          ],
          "ends": ".zip",
          "prerelease": true
        }
      }
    },
    {
      "id": "melonds",
      "name": "melonDS",
      "args": [
        "-f",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "melonDS-emu/melonDS",
          "has": [
            "appimage",
            "x86_64"
          ],
          "ends": ".zip"
        },
        "macos": {
          "type": "github",
          "repo": "melonDS-emu/melonDS",
          "has": [
            "macos"
          ],
          "ends": ".zip"
        }
      }
    },
    {
      "id": "eden",
      "name": "Eden",
      "args": [
        "-f",
        "-g",
        "{rom}"
      ],
      "binaries": [
        "eden"
      ],
      "mac_apps": [
        "Eden.app/Contents/MacOS/eden"
      ],
      "install": {
        "linux": {
          "type": "gitea",
          "base": "https://git.eden-emu.dev",
          "repo": "eden-emu/eden",
          "has": [
            "linux"
          ],
          "not": [
            "aarch64",
            "arm64",
            "armv"
          ],
          "ends": [
            ".appimage"
          ]
        },
        "macos": {
          "type": "gitea",
          "base": "https://git.eden-emu.dev",
          "repo": "eden-emu/eden",
          "has": [
            "mac"
          ],
          "ends": [
            ".dmg",
            ".tar.gz",
            ".zip"
          ]
        }
      }
    },
    {
      "id": "citron",
      "name": "Citron Neo",
      "args": [
        "-f",
        "-g",
        "{rom}"
      ],
      "binaries": [
        "citron"
      ],
      "mac_apps": [
        "Citron.app/Contents/MacOS/citron"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "citron-neo/emulator",
          "ends": "-linux-x86_64.appimage"
        },
        "macos": {
          "type": "github",
          "repo": "citron-neo/emulator",
          "has": [
            "macos"
          ],
          "ends": ".dmg"
        }
      }
    },
    {
      "id": "ryubing",
      "name": "Ryubing (Ryujinx)",
      "args": [
        "--fullscreen",
        "{rom}"
      ],
      "binaries": [
        "Ryujinx"
      ],
      "mac_apps": [
        "Ryujinx.app/Contents/MacOS/Ryujinx"
      ],
      "install": {
        "linux": {
          "type": "gitlab",
          "base": "https://git.ryujinx.app",
          "project": "ryubing/ryujinx",
          "has": [
            "linux"
          ],
          "not": [
            "arm64",
            "aarch64"
          ],
          "ends": [
            ".appimage",
            ".tar.gz"
          ],
          "exe": "Ryujinx"
        },
        "macos": {
          "type": "gitlab",
          "base": "https://git.ryujinx.app",
          "project": "ryubing/ryujinx",
          "has": [
            "macos"
          ],
          "ends": [
            ".tar.gz",
            ".zip"
          ]
        }
      }
    },
    {
      "id": "xenia",
      "name": "Xenia Canary",
      "args": [
        "--fullscreen=true",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "xenia-canary/xenia-canary-releases",
          "has": [
            "linux"
          ],
          "ends": ".tar.xz",
          "exe": "xenia_canary"
        }
      }
    },
    {
      "id": "rpcs3",
      "name": "RPCS3",
      "args": [
        "--no-gui",
        "--fullscreen",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "RPCS3/rpcs3-binaries-linux",
          "has": [
            "linux64"
          ],
          "ends": ".appimage"
        },
        "macos": {
          "type": "github",
          "repo": "RPCS3/rpcs3-binaries-mac-arm64",
          "has": [
            "macos"
          ],
          "ends": ".7z"
        }
      }
    },
    {
      "id": "shadps4",
      "name": "shadPS4",
      "args": [
        "-f",
        "true",
        "-g",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "shadps4-emu/shadPS4",
          "has": [
            "linux"
          ],
          "ends": ".zip",
          "exe": "Shadps4-sdl.AppImage"
        },
        "macos": {
          "type": "github",
          "repo": "shadps4-emu/shadPS4",
          "has": [
            "macos"
          ],
          "ends": ".zip"
        }
      }
    }
  ],
