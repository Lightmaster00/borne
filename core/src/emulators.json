{
  "_comment": "Emulators Borne installs, configures and starts. 'programs' says where each program comes from on each system and how it is started ({rom}, {core}, {config}, {lang_dolphin}); 'consoles' lists, per console, the choices offered in Settings -> Emulators (the first one is the default). Read by core/src/emulators.rs and core/src/emuinstall.rs. A console with an empty list has no usable emulator yet (Xbox One).",
  "programs": [
    {
      "id": "vita3k",
      "name": "Vita3K",
      "args": [
        "-F",
        "--frontend",
        "sdl",
        "{rom}"
      ],
      "binaries": [
        "Vita3K",
        "vita3k"
      ],
      "mac_apps": [
        "Vita3K.app/Contents/MacOS/Vita3K"
      ],
      "fails": [
        "is not a supported content type",
        "needs an installed app to run",
        "Failed to install"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "Vita3K/Vita3K",
          "has": [
            "x86_64"
          ],
          "ends": ".appimage"
        },
        "macos": {
          "type": "github",
          "repo": "Vita3K/Vita3K",
          "has": [
            "macos-arm64"
          ],
          "ends": ".dmg"
        }
      },
      "logs": [
        "vita3k.log",
        "../vita3k.log"
      ]
    },
    {
      "id": "retroarch",
      "name": "RetroArch",
      "args": [
        "--config",
        "{config}",
        "-L",
        "{core}",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "buildbot",
          "file": "linux/x86_64/RetroArch.7z"
        },
        "macos": {
          "type": "buildbot",
          "file": "apple/osx/universal/RetroArch_Metal.dmg"
        }
      },
      "cores": {
        "linux": "https://buildbot.libretro.com/nightly/linux/x86_64/latest/{core}_libretro.so.zip",
        "macos": "https://buildbot.libretro.com/nightly/apple/osx/arm64/latest/{core}_libretro.dylib.zip"
      },
      "fails": [
        "Failed to load content",
        "Failed to open libretro core",
        "Fatal error received",
        "Could not read content file",
        "Failed to load core"
      ]
    },
    {
      "id": "dolphin",
      "name": "Dolphin",
      "binaries": [
        "dolphin-emu"
      ],
      "args": [
        "-b",
        "-u",
        "{userdir}",
        "-C",
        "Dolphin.Core.SelectedLanguage={lang_dolphin}",
        "-e",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "flatpak",
          "id": "org.DolphinEmu.dolphin-emu"
        },
        "macos": {
          "type": "page",
          "url": "https://dolphin-emu.org/download/",
          "link": "https://dl.dolphin-emu.org/releases/",
          "ends": "-universal.dmg"
        }
      },
      "fails": [
        "Unable to load the game",
        "is not a valid GameCube/Wii"
      ]
    },
    {
      "id": "pcsx2",
      "name": "PCSX2",
      "binaries": [
        "pcsx2-qt",
        "pcsx2"
      ],
      "args": [
        "-batch",
        "-fullscreen",
        "-nogui",
        "--",
        "{rom}"
      ],
      "install": {
        "linux": {
          "type": "github",
          "repo": "PCSX2/pcsx2",
